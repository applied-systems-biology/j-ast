        "jipipe:parameter-slot-algorithm/attach-parameter-annotations" : true,
        "jipipe:parameter-slot-algorithm/attach-only-non-default-parameter-annotations" : true,
        "jipipe:parameter-slot-algorithm/parameter-annotations-prefix" : "",
        "jipipe:parameter-slot-algorithm/parameter-annotations-use-internal-names" : false,
        "jipipe:data-batch-generation/annotation-merge-strategy" : "Merge",
        "jipipe:data-batch-generation/column-matching" : "PrefixHashUnion",
        "jipipe:data-batch-generation/data-annotation-merge-strategy" : "MergeTables",
        "jipipe:data-batch-generation/custom-matched-columns-expression" : {
          "expression" : ""
        },
        "jipipe:data-batch-generation/skip-incomplete" : true,
        "jipipe:data-batch-generation/custom-annotation-matching" : {
          "expression" : "exact_match_results"
