        "jipipe:algorithm:pass-through" : false,
        "script" : {
          "code" : "df.all <- JIPipe.GetInputAsDataFrame(\"Input\")\ndf.scores <- data.frame()\n\n# Calculate scores\n\nfor(group in unique(df.all$ShapeConfig)) {\n  df <- df.all[df.all$ShapeConfig == group,]\n  \n  # variance\n  lo.var <- loess(var~label_id, data=df)\n  lo.var.f <- function(x) {\n    predict(lo.var, newdata = data.frame(label_id = x))\n  }\n  auc2 <- integrate(lo.var.f, lower = min(df$label_id), upper = max(df$label_id))$value\n  \n  # mean\n  lo.mean <- loess(Mean~label_id, data=df)\n  lo.mean.f <- function(x) {\n    predict(lo.mean, newdata = data.frame(label_id = x))\n  }\n  lo.mean.f.deriv <- function(x) {\n    h <- 1e-6  # Small increment for numerical differentiation\n    (lo.mean.f(x + h) - lo.mean.f(x - h)) / (2 * h)\n  }\n  auc1 <- integrate(lo.mean.f.deriv, lower = min(df$label_id), upper = max(df$label_id))$value\n  \n  df.scores <- rbind(df.scores, data.frame(ShapeConfig=group, score_mean=auc1, score_var=auc2))\n}\n\ndf.scores$score_mean <- df.scores$score_mean / max(df.scores$score_mean)\ndf.scores$score_var <- 1 - (df.scores$score_var / max(df.scores$score_var))\ndf.scores$score_combined <- df.scores$score_mean * df.scores$score_var\n\n# Pareto font\ndominates <- function(p1, p2) {\n  any(p1[c(\"score_mean\", \"score_var\")] > p2[c(\"score_mean\", \"score_var\")]) &&\n    all(p1[c(\"score_mean\", \"score_var\")] >= p2[c(\"score_mean\", \"score_var\")])\n}\ndf.paretofront <- data.frame()\n\nfor (i in 1:nrow(df.scores)) {\n  is_dominated <- FALSE\n  for (j in 1:nrow(df.scores)) {\n    \n    if (i == j) {\n      next\n    }\n    \n    if (dominates(df.scores[j, ], df.scores[i, ])) {\n      is_dominated <- TRUE\n      break\n    }\n  }\n  if (!is_dominated) {\n    df.paretofront <- rbind(df.paretofront, df.scores[i,])\n  }\n}\n\n# Sort the pareto front and take the result with the highest score\ndf.paretofront <- df.paretofront[order(df.paretofront$score_combined, decreasing = T), ]\n\n\nJIPipe.AddOutputDataFrame(slot=\"Output\", data=df.paretofront)",
          "collapsed" : false,
          "external-script-file" : {
            "content" : "",
            "enabled" : false
          }
        },
