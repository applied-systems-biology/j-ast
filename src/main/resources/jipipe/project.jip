      "d9cc2e22-e5e3-40ba-9df4-ce743ec338a0" : {
        "jipipe:graph-compartment" : "cce5a3b9-a2cb-46b7-8368-d372f60d8f8d",
        "jipipe:alias-id" : "e-strip-find-label-radius-area",
        "jipipe:slot-configuration" : {
          "input" : {
            "ECC" : {
              "slot-data-type" : "imagej-roi",
              "slot-type" : "Input",
              "name" : "ECC",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            },
            "Reference" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
              "name" : "Reference",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          },
          "output" : {
            "Output" : {
              "slot-data-type" : "imagej-roi",
              "slot-type" : "Output",
              "name" : "Output",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:ui-grid-location" : {
          "cce5a3b9-a2cb-46b7-8368-d372f60d8f8d" : {
            "VerticalCompact" : {
              "x" : 102,
              "y" : 15
            }
          }
        },
        "jipipe:node-info-id" : "python-script-iterating",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from org.hkijena.jipipe.extensions.imagejdatatypes.datatypes import ROIListData\nfrom org.hkijena.jipipe.extensions.imagejdatatypes.datatypes import ImagePlusData\nfrom ij.gui import PolygonRoi\nimport math\nimport itertools\nfrom jarray import array\n\ninput_image = data_batch.getInputData(\"Reference\", ImagePlusData, progress_info).getImage()\nimg_width = input_image.getWidth()\nimg_height = input_image.getHeight()\n\ninput_roi = data_batch.getInputData(\"ECC\", ROIListData, progress_info)\nroi = input_roi.get(0)\npolygon = roi.getPolygon()\nxpoints = polygon.xpoints\nypoints = polygon.ypoints\npoints = [(xpoints[i], ypoints[i]) for i in range(len(xpoints))]\npoints_d = []\n\nfor p1, p2 in itertools.combinations(points, 2):\n    d = math.sqrt((p1[0] - p2[0])**2 + (p1[1] - p2[1])**2)\n    if p1[0] > p2[0]:\n        (p1, p2) = (p2, p1)\n    points_d.append({ \"p1\": p1, \"p2\": p2, \"d\": d })\n\npoints_d.sort(key = lambda x: x[\"d\"])\n# [left/right] [left/right] [top] [bottom] [diagonal] [diagonal]\n\ntop = points_d[2]\nbottom = points_d[3]\n\nm1 = float(top[\"p1\"][1] - top[\"p2\"][1]) / (top[\"p1\"][0] - top[\"p2\"][0])\nn1 = top[\"p1\"][1] - m1 * top[\"p1\"][0]\n\n#m2 = float(bottom[\"p1\"][1] - bottom[\"p2\"][1]) / (bottom[\"p1\"][0] - bottom[\"p2\"][0])\nm2 = m1\nn2 = bottom[\"p1\"][1] - m2 * bottom[\"p1\"][0]\n\ndef f(x):\n    return m1 * x + n1\ndef f1(x):\n    return m2 * x + n2\n\nnew_xpoints = [0, 0, img_width, img_width]\n#new_xpoints = [x1,x1,x2,x2]\nnew_ypoints = [f1(new_xpoints[0]), f(new_xpoints[1]), f(new_xpoints[2]), f1(new_xpoints[3])]\nnew_ypoints = [int(x) for x in new_ypoints]\n\nnew_roi = PolygonRoi(array(new_xpoints, \"i\"), array(new_ypoints, \"i\"), 4, 2)\noutput_roi = ROIListData()\noutput_roi.add(new_roi)\n\ndata_batch.addOutputData(\"Output\", output_roi, progress_info)\n\n",
          "collapsed" : false,
          "external-script-file" : {
            "content" : "",
            "enabled" : false
          }
        },
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "E-Strip find label radius area",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 0
        },
        "jipipe:node:description" : "<html>\n  <head>\n    \n  </head>\n  <body>\n    <p>\n      Takes the ECC and prolongs it to the image borders (including \n      orientation) using some line formulas\n    </p>\n  </body>\n</html>\n",
        "jipipe:algorithm:custom-expression-variables" : {
          "parameters" : { }
        },
        "jipipe:adaptive-parameters/attach-parameter-annotations" : true,
        "jipipe:adaptive-parameters/attach-only-non-default-parameter-annotations" : true,
