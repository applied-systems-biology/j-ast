        "jipipe:node-info-id" : "threshold-iterative-by-roi-statistics-2d",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "exclude-edge-roi" : false,
        "jipipe:node:bookmarked" : false,
        "threshold-annotation-strategy" : "OverwriteExisting",
        "jipipe:algorithm:pass-through" : false,
        "measure-in-physical-units" : true,
        "jipipe:node:name" : "Object-based iterative thresholding 2D",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 0
        },
        "jipipe:node:description" : "<html><head></head><body></body></html>",
        "threshold-combine-expression" : {
          "expression" : "MIN(thresholds)"
        },
        "thresholds" : {
          "value" : "0-255",
          "is-expression" : true,
          "expression" : {
            "expression" : "MAKE_SEQUENCE(10, 250, 5)"
          }
        },
        "threshold-annotation" : {
          "content" : "Threshold",
          "enabled" : false
        },
        "measurements" : {
          "values" : [ "ShapeDescriptors", "FeretDiameter" ],
          "collapsed" : false
        },
        "filtering/threshold-criteria" : {
          "expression" : "LENGTH(filtered_roi) >= 1"
        },
        "filtering/roi-filter" : {
          "expression" : "SET_VARIABLE(\"cminf_px\", 0.25 * custom.minFeret * (NUM(plate_diameter_px) / NUM(plate_diameter_mm)));\nSET_VARIABLE(\"cmaxf_px\", 0.25 * custom.maxFeret * (NUM(plate_diameter_px) / NUM(plate_diameter_mm)));\nMinFeret >= cminf_px AND Feret >= cminf_px AND MinFeret <= cmaxf_px AND Feret <= cmaxf_px AND Circ. >= custom.minCirc"
        },
        "jipipe:algorithm:custom-expression-variables" : {
          "parameters" : {
            "minFeret" : {
              "key" : "minFeret",
              "name" : "minFeret",
              "description" : "",
              "hidden" : false,
              "field-class" : "java.lang.Double",
              "value" : 3.0,
              "short-key" : "minFeret",
              "ui-order" : 0,
              "field-class-id" : "double"
            },
            "maxFeret" : {
              "key" : "maxFeret",
              "name" : "maxFeret",
              "description" : "",
              "hidden" : false,
              "field-class" : "java.lang.Double",
              "value" : 12.0,
              "short-key" : "maxFeret",
              "ui-order" : 0,
              "field-class-id" : "double"
            },
            "minCirc" : {
              "key" : "minCirc",
              "name" : "minCirc",
              "description" : "",
              "hidden" : false,
              "field-class" : "java.lang.Double",
              "value" : 0.5,
              "short-key" : "minCirc",
              "ui-order" : 0,
              "field-class-id" : "double"
            }
          }
        },
        "jipipe:adaptive-parameters/attach-parameter-annotations" : true,
        "jipipe:adaptive-parameters/attach-only-non-default-parameter-annotations" : true,
        "jipipe:adaptive-parameters/parameter-annotations-prefix" : "",
        "jipipe:adaptive-parameters/overridden-parameters" : [ ],
