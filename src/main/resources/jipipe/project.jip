      "f37619df-9f61-4033-b000-1271b68b5f68" : {
        "jipipe:graph-compartment" : "495694f6-1173-40d4-be52-49e214548b67",
        "jipipe:alias-id" : "r-script-iterating",
        "jipipe:slot-configuration" : {
          "input" : {
            "Early" : {
              "slot-data-type" : "imagej-results-table",
              "slot-type" : "Input",
              "name" : "Early",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            },
            "Late" : {
              "slot-data-type" : "imagej-results-table",
              "slot-type" : "Input",
              "name" : "Late",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          },
          "output" : {
            "Output" : {
              "slot-data-type" : "imagej-results-table",
              "slot-type" : "Output",
              "name" : "Output",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
              "is-optional" : false
            }
          }
        },
        "jipipe:ui-grid-location" : {
          "" : {
            "VerticalCompact" : {
              "x" : 66,
              "y" : 37
            }
          },
          "495694f6-1173-40d4-be52-49e214548b67" : {
            "VerticalCompact" : {
              "x" : 26,
              "y" : 13
            }
          }
        },
        "jipipe:node-info-id" : "r-script-iterating",
        "annotation-merge-strategy" : "Merge",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "script" : {
          "code" : "df.early <- JIPipe.GetInputAsDataFrame(\"Early\")\ndf.late <- JIPipe.GetInputAsDataFrame(\"Late\")\n\n# Remove zero mean\ndf.early <- df.early[df.early$mean > 0,]\n\n# Remove everything after reaching max\n#df.early.peak <- which(df.early$mean == max(df.early$mean))[1]\n#df.early <- df.early[seq_len(df.early.peak),]\n\n# Choose relative mean value\ndf.early$rmean <- df.early$rel_intensity_max\ndf.late$rmean <- df.late$rel_intensity_max\n\nfor(growth_reduction in thresholds) {\n    print(paste(\"Growth reduction\", growth_reduction))\n    threshold <- 1 - growth_reduction\n\n    rad_mm <- df.early[df.early$rmean >= threshold,]$r_mm[1]\n    rad_px <- df.early[df.early$rmean >= threshold,]$r_px[1]\n\n    # Create a function for the integration\n    f <- approxfun(x = df.late$r_px, y = df.late$rmean, method=\"linear\", rule=2, yright=0)\n    f.early <- approxfun(x = df.early$r_px, y = df.early$rmean, method=\"linear\", rule=2, yright=0)\n\n    df.late.filtered <- df.late[df.late$r_px <= rad_px,]\n    mri <- max(df.late.filtered$rmean)\n\n\n    auc <- integrate(f, lower=0, upper=rad_px, subdivisions = 2000)$value\n    amax <- rad_px * mri\n    fog <- auc / amax\n\n    # Create output data table\n    df.out <- data.frame(AUC=auc, FoG=fog, t=growth_reduction, RAD_px=rad_px, RAD_mm=rad_mm)\n    JIPipe.AddOutputDataFrame(slot=\"Output\", data=df.out, annotations=list(\"#Threshold\"=as.character(growth_reduction)))\n}",
          "collapsed" : false,
          "external-script-file" : {
            "content" : "",
            "enabled" : false
          }
        },
        "jipipe:node:name" : "R script (iterating)",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 0
        },
        "jipipe:node:description" : "<html><head></head><body></body></html>",
        "cleanup-afterwards" : true,
        "override-environment" : {
