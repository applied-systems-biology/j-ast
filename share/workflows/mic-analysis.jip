    "node-templates" : [ {
      "name" : "Register by channel 1",
      "description" : "<html>\n  <head>\n    \n  </head>\n  <body>\n    <p>\n      Only calculate the transformation for slices in channel=1. Register all \n      other channels according to this alignment.\n    </p>\n  </body>\n</html>\n",
      "menu-path" : [ ],
      "icon" : "actions/transform-shear-right.png",
      "data" : "{\n  \"nodes\" : {\n    \"01e5aeb4-0eb9-4e37-9a16-2c971d9bbd96\" : {\n      \"jipipe:graph-compartment\" : \"\",\n      \"jipipe:alias-id\" : \"turboreg-registration-2d-simple\",\n      \"jipipe:slot-configuration\" : {\n        \"input\" : {\n          \"Input\" : {\n            \"slot-data-type\" : \"imagej-imgplus\",\n            \"slot-type\" : \"Input\",\n            \"name\" : \"Input\",\n            \"custom-name\" : null,\n            \"description\" : \"The target image that will be registered to the reference\",\n            \"is-virtual\" : false,\n            \"save-outputs\" : true,\n            \"is-optional\" : false\n          }\n        },\n        \"output\" : {\n          \"Output\" : {\n            \"slot-data-type\" : \"imagej-imgplus\",\n            \"slot-type\" : \"Output\",\n            \"name\" : \"Output\",\n            \"custom-name\" : null,\n            \"description\" : \"The registered image\",\n            \"is-virtual\" : false,\n            \"save-outputs\" : true,\n            \"is-optional\" : false\n          },\n          \"Transform\" : {\n            \"slot-data-type\" : \"json\",\n            \"slot-type\" : \"Output\",\n            \"name\" : \"Transform\",\n            \"custom-name\" : null,\n            \"description\" : \"The transform serialized in JSON format\",\n            \"is-virtual\" : false,\n            \"save-outputs\" : true,\n            \"is-optional\" : false\n          }\n        }\n      },\n      \"jipipe:metadata-v1\" : {\n        \"location/_/y\" : 15,\n        \"location/_/x\" : 36\n      },\n      \"jipipe:node-info-id\" : \"ij1-turbo-reg-image-registration-io\",\n      \"jipipe:algorithm:enabled\" : true,\n      \"jipipe:node:ui-locked\" : false,\n      \"transformation-type\" : \"Affine\",\n      \"rules\" : {\n        \"template\" : {\n          \"parameters\" : {\n            \"condition\" : {\n              \"key\" : \"condition\",\n              \"name\" : \"Match if ...\",\n              \"description\" : \"Determines whether this condition matches\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"true\"\n              },\n              \"short-key\" : \"condition\",\n              \"ui-order\" : -99,\n              \"field-class-id\" : \"expression\"\n            },\n            \"reference-t-index\" : {\n              \"key\" : \"reference-t-index\",\n              \"name\" : \"Reference frame index\",\n              \"description\" : \"Depends from which slice the transformation is sourced.<br/>For type 'Calculate transformation' this refers to a Z/C/T slice in the reference image.<br/>For type 'Use transformation' this refers to a Z/C/T slice that already has a transformation.<br/>Please note unless you only have 'Ignore' type rules there must be some alignment transformation that needs to be calculated.\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"t\"\n              },\n              \"short-key\" : \"reference-t-index\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"expression\"\n            },\n            \"rule-type\" : {\n              \"key\" : \"rule-type\",\n              \"name\" : \"Type\",\n              \"description\" : \"Determines if the slices matches by this rule are ignored, are aligned to the reference, or follow a pre-calculated transformation\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.imagejalgorithms.nodes.registration.turboreg.TurboRegRegistrationAlgorithmRuleType\",\n              \"value\" : \"CalculateTransformation\",\n              \"short-key\" : \"rule-type\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"ij1-turbo-reg-image-registration:rule-type\"\n            },\n            \"reference-z-index\" : {\n              \"key\" : \"reference-z-index\",\n              \"name\" : \"Reference Z index\",\n              \"description\" : \"Depends from which slice the transformation is sourced.<br/>For type 'Calculate transformation' this refers to a Z/C/T slice in the reference image.<br/>For type 'Use transformation' this refers to a Z/C/T slice that already has a transformation.<br/>Please note unless you only have 'Ignore' type rules there must be some alignment transformation that needs to be calculated.\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"z\"\n              },\n              \"short-key\" : \"reference-z-index\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"expression\"\n            },\n            \"reference-c-index\" : {\n              \"key\" : \"reference-c-index\",\n              \"name\" : \"Reference channel index\",\n              \"description\" : \"Depends from which slice the transformation is sourced.<br/>For type 'Calculate transformation' this refers to a Z/C/T slice in the reference image.<br/>For type 'Use transformation' this refers to a Z/C/T slice that already has a transformation.<br/>Please note unless you only have 'Ignore' type rules there must be some alignment transformation that needs to be calculated.\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"c\"\n              },\n              \"short-key\" : \"reference-c-index\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"expression\"\n            }\n          }\n        },\n        \"items\" : [ {\n          \"parameters\" : {\n            \"reference-t-index\" : {\n              \"key\" : \"reference-t-index\",\n              \"name\" : \"Reference frame index\",\n              \"description\" : \"Depends from which slice the transformation is sourced.<br/>For type 'Calculate transformation' this refers to a Z/C/T slice in the reference image.<br/>For type 'Use transformation' this refers to a Z/C/T slice that already has a transformation.<br/>Please note unless you only have 'Ignore' type rules there must be some alignment transformation that needs to be calculated.\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"t\"\n              },\n              \"short-key\" : \"reference-t-index\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"expression\"\n            },\n            \"condition\" : {\n              \"key\" : \"condition\",\n              \"name\" : \"Match if ...\",\n              \"description\" : \"Determines whether this condition matches\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"c == 1\"\n              },\n              \"short-key\" : \"condition\",\n              \"ui-order\" : -99,\n              \"field-class-id\" : \"expression\"\n            },\n            \"rule-type\" : {\n              \"key\" : \"rule-type\",\n              \"name\" : \"Type\",\n              \"description\" : \"Determines if the slices matches by this rule are ignored, are aligned to the reference, or follow a pre-calculated transformation\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.imagejalgorithms.nodes.registration.turboreg.TurboRegRegistrationAlgorithmRuleType\",\n              \"value\" : \"CalculateTransformation\",\n              \"short-key\" : \"rule-type\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"ij1-turbo-reg-image-registration:rule-type\"\n            },\n            \"reference-z-index\" : {\n              \"key\" : \"reference-z-index\",\n              \"name\" : \"Reference Z index\",\n              \"description\" : \"Depends from which slice the transformation is sourced.<br/>For type 'Calculate transformation' this refers to a Z/C/T slice in the reference image.<br/>For type 'Use transformation' this refers to a Z/C/T slice that already has a transformation.<br/>Please note unless you only have 'Ignore' type rules there must be some alignment transformation that needs to be calculated.\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"z\"\n              },\n              \"short-key\" : \"reference-z-index\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"expression\"\n            },\n            \"reference-c-index\" : {\n              \"key\" : \"reference-c-index\",\n              \"name\" : \"Reference channel index\",\n              \"description\" : \"Depends from which slice the transformation is sourced.<br/>For type 'Calculate transformation' this refers to a Z/C/T slice in the reference image.<br/>For type 'Use transformation' this refers to a Z/C/T slice that already has a transformation.<br/>Please note unless you only have 'Ignore' type rules there must be some alignment transformation that needs to be calculated.\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"c\"\n              },\n              \"short-key\" : \"reference-c-index\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"expression\"\n            }\n          }\n        }, {\n          \"parameters\" : {\n            \"reference-t-index\" : {\n              \"key\" : \"reference-t-index\",\n              \"name\" : \"Reference frame index\",\n              \"description\" : \"Depends from which slice the transformation is sourced.<br/>For type 'Calculate transformation' this refers to a Z/C/T slice in the reference image.<br/>For type 'Use transformation' this refers to a Z/C/T slice that already has a transformation.<br/>Please note unless you only have 'Ignore' type rules there must be some alignment transformation that needs to be calculated.\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"t\"\n              },\n              \"short-key\" : \"reference-t-index\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"expression\"\n            },\n            \"condition\" : {\n              \"key\" : \"condition\",\n              \"name\" : \"Match if ...\",\n              \"description\" : \"Determines whether this condition matches\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"true\"\n              },\n              \"short-key\" : \"condition\",\n              \"ui-order\" : -99,\n              \"field-class-id\" : \"expression\"\n            },\n            \"rule-type\" : {\n              \"key\" : \"rule-type\",\n              \"name\" : \"Type\",\n              \"description\" : \"Determines if the slices matches by this rule are ignored, are aligned to the reference, or follow a pre-calculated transformation\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.imagejalgorithms.nodes.registration.turboreg.TurboRegRegistrationAlgorithmRuleType\",\n              \"value\" : \"UseTransformation\",\n              \"short-key\" : \"rule-type\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"ij1-turbo-reg-image-registration:rule-type\"\n            },\n            \"reference-z-index\" : {\n              \"key\" : \"reference-z-index\",\n              \"name\" : \"Reference Z index\",\n              \"description\" : \"Depends from which slice the transformation is sourced.<br/>For type 'Calculate transformation' this refers to a Z/C/T slice in the reference image.<br/>For type 'Use transformation' this refers to a Z/C/T slice that already has a transformation.<br/>Please note unless you only have 'Ignore' type rules there must be some alignment transformation that needs to be calculated.\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"z\"\n              },\n              \"short-key\" : \"reference-z-index\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"expression\"\n            },\n            \"reference-c-index\" : {\n              \"key\" : \"reference-c-index\",\n              \"name\" : \"Reference channel index\",\n              \"description\" : \"Depends from which slice the transformation is sourced.<br/>For type 'Calculate transformation' this refers to a Z/C/T slice in the reference image.<br/>For type 'Use transformation' this refers to a Z/C/T slice that already has a transformation.<br/>Please note unless you only have 'Ignore' type rules there must be some alignment transformation that needs to be calculated.\",\n              \"hidden\" : false,\n              \"field-class\" : \"org.hkijena.jipipe.plugins.expressions.JIPipeExpressionParameter\",\n              \"value\" : {\n                \"expression\" : \"1\"\n              },\n              \"short-key\" : \"reference-c-index\",\n              \"ui-order\" : 0,\n              \"field-class-id\" : \"expression\"\n            }\n          }\n        } ]\n      },\n      \"jipipe:node:bookmarked\" : false,\n      \"jipipe:algorithm:pass-through\" : false,\n      \"restore-original-annotations\" : true,\n      \"jipipe:node:name\" : \"TurboReg registration 2D (simple)\",\n      \"jipipe:algorithm:runtime-partition\" : {\n        \"index\" : 0\n      },\n      \"jipipe:node:description\" : \"<html><head></head><body></body></html>\",\n      \"jipipe:local-parallelization-num-threads\" : {\n        \"content\" : 1,\n        \"enabled\" : false\n      },\n      \"advanced-parameters/min-size\" : 12,\n      \"jipipe:algorithm:custom-expression-variables\" : {\n        \"parameters\" : { }\n      },\n      \"jipipe:environment-overrides\" : {\n        \"parameters\" : { }\n      },\n      \"jipipe:adaptive-parameters/attach-parameter-annotations\" : true,\n      \"jipipe:adaptive-parameters/attach-only-non-default-parameter-annotations\" : true,\n      \"jipipe:adaptive-parameters/parameter-annotations-prefix\" : \"\",\n      \"jipipe:adaptive-parameters/overridden-parameters\" : [ ],\n      \"jipipe:adaptive-parameters/enabled\" : true,\n      \"jipipe:adaptive-parameters/parameter-annotations-use-internal-names\" : false,\n      \"jipipe:parameter-slot-algorithm/has-parameter-slot\" : false,\n      \"jipipe:parameter-slot-algorithm/attach-parameter-annotations\" : true,\n      \"jipipe:parameter-slot-algorithm/attach-only-non-default-parameter-annotations\" : true,\n      \"jipipe:parameter-slot-algorithm/parameter-annotations-prefix\" : \"\",\n      \"jipipe:parameter-slot-algorithm/parameter-annotations-use-internal-names\" : false,\n      \"jipipe:data-batch-generation/annotation-merge-strategy\" : \"Merge\",\n      \"jipipe:data-batch-generation/column-matching\" : \"PrefixHashUnion\",\n      \"jipipe:data-batch-generation/data-annotation-merge-strategy\" : \"MergeTables\",\n      \"jipipe:data-batch-generation/solver-preference\" : \"Auto\",\n      \"jipipe:data-batch-generation/custom-matched-columns-expression\" : {\n        \"expression\" : \"\"\n      },\n      \"jipipe:data-batch-generation/skip-incomplete\" : false,\n      \"jipipe:data-batch-generation/custom-annotation-matching\" : {\n        \"expression\" : \"exact_match_results\"\n      },\n      \"jipipe:data-batch-generation/limit\" : {\n        \"content\" : {\n          \"value\" : \"0-9\",\n          \"is-expression\" : false,\n          \"expression\" : {\n            \"expression\" : \"MAKE_SEQUENCE(0, 10)\"\n          }\n        },\n        \"enabled\" : false\n      },\n      \"jipipe:data-batch-generation/annotation-matching-method\" : \"ExactMatch\"\n    }\n  },\n  \"edges\" : [ ]\n}",
      "fill-color" : "#E6DECF",
      "border-color" : "#807B73"
    }, {
      "name" : "Register to last frame of channel 0",
      "description" : "<html>\n  <head>\n\n  </head>\n  <body>\n    <p>\n      Only calculate the alignment for channel 0, with the last frame as \n      reference. For all other Z/C/T slices apply the same transformation.\n    </p>\n  </body>\n</html>\n",
