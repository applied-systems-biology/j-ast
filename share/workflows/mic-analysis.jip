      "044ea95b-cee5-49e5-bd00-cff3dfe045b4" : {
        "jipipe:graph-compartment" : "e0411412-045e-437f-b700-180112b40857",
        "jipipe:alias-id" : "export-image-2",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-imgplus",
              "slot-type" : "Input",
