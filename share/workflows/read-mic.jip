      "0ffac864-18f5-4de4-86ef-9f3c6a8535ae" : {
        "jipipe:graph-compartment" : "f974fbbe-e15f-4b4a-a820-eb22c4f7808d",
        "jipipe:alias-id" : "find-threshold-otsu",
        "jipipe:slot-configuration" : {
          "input" : {
            "Input" : {
              "slot-data-type" : "imagej-results-table",
              "slot-type" : "Input",
              "name" : "Input",
              "custom-name" : null,
              "description" : "",
              "is-virtual" : false,
              "save-outputs" : true,
