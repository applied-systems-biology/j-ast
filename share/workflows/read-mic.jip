        },
        "jipipe:ui-grid-location" : {
          "" : {
            "VerticalCompact" : {
              "x" : 57,
              "y" : 53
            }
          },
          "f974fbbe-e15f-4b4a-a820-eb22c4f7808d" : {
            "VerticalCompact" : {
              "x" : 5,
              "y" : 38
            }
          }
        },
        "jipipe:node-info-id" : "python-script-iterating-simple",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from org.hkijena.jipipe.api.data import JIPipeData\nfrom org.hkijena.jipipe.api.annotation import JIPipeTextAnnotation, JIPipeTextAnnotationMergeMode\n\n# Jython / Python 2.7 compatible\n\ndef triangle_threshold_index(hist):\n    \"\"\"\n    Triangle (Zack) threshold for an already-computed histogram.\n\n    Args:\n        hist: sequence (e.g., float[] or list) where hist[i] is the bin count/weight.\n\n    Returns:\n        int: threshold index in [0, len(hist)-1]\n    \"\"\"\n    n = len(hist)\n    if n == 0:\n        raise ValueError(\"Histogram is empty\")\n\n    # Find first/last non-zero bins\n    left = 0\n    while left < n and float(hist[left]) <= 0.0:\n        left += 1\n    if left == n:\n        return 0  # all zeros\n\n    right = n - 1\n    while right >= 0 and float(hist[right]) <= 0.0:\n        right -= 1\n    if right <= left:\n        return left\n\n    # Find peak position (max height) within [left, right]\n    peak = left\n    peak_val = float(hist[left])\n    for i in range(left + 1, right + 1):\n        v = float(hist[i])\n        if v > peak_val:\n            peak_val = v\n            peak = i\n\n    # Ensure the \"tail\" is to the right of the peak by flipping if needed.\n    # We compare distances from peak to ends; if left tail is longer, flip.\n    flip = (peak - left) > (right - peak)\n\n    if flip:\n        # Work on a flipped view: i' = right - (i - left)\n        # Build a compact array for [left..right] reversed\n        m = right - left + 1\n        h = [0.0] * m\n        for i in range(m):\n            h[i] = float(hist[right - i])\n        # In flipped coords:\n        left2 = 0\n        right2 = m - 1\n        peak2 = right - peak  # because peak maps to index (right - peak) in the flipped segment\n        # We'll compute threshold in flipped coords and map back at end.\n    else:\n        # Use compact array in original order\n        m = right - left + 1\n        h = [0.0] * m\n        for i in range(m):\n            h[i] = float(hist[left + i])\n        left2 = 0\n        right2 = m - 1\n        peak2 = peak - left\n\n    # Now apply triangle method on h[left2..right2], with peak at peak2,\n    # and tail endpoint at right2.\n    x1, y1 = peak2, h[peak2]\n    x2, y2 = right2, h[right2]\n\n    # If the tail endpoint has the same x as peak (degenerate), return peak.\n    if x2 == x1:\n        t2 = peak2\n    else:\n        # Line from (x1,y1) to (x2,y2): compute max perpendicular distance\n        # Use equivalent \"area\" / distance without sqrt:\n        # dist ~ |(y2-y1)*x0 - (x2-x1)*y0 + x2*y1 - y2*x1|\n        # Denominator is constant, so we just maximize numerator abs.\n        a = (y2 - y1)\n        b = -(x2 - x1)\n        c = (x2 * y1 - y2 * x1)\n\n        max_dist = -1.0\n        t2 = peak2\n\n        # Search between peak and tail (excluding peak is fine; including doesn't hurt)\n        for x0 in range(peak2, right2 + 1):\n            y0 = h[x0]\n            dist = a * x0 + b * y0 + c\n            if dist < 0.0:\n                dist = -dist\n            if dist > max_dist:\n                max_dist = dist\n                t2 = x0\n\n    # Map threshold back to original histogram index\n    if flip:\n        # t2 is index in flipped compact segment where compact index i corresponds to original (right - i)\n        return right - t2\n    else:\n        return left + t2\n\n\ninput_slot = input_slot_map[\"Input\"]\noutput_slot = output_slot_map[\"Output\"]\ninput_table = data_batch.getInputData(input_slot, JIPipeData, progress_info)\nlabels = []\nmeans = []\ns_values = []\n\nfor i in range(input_table.getRowCount()):\n\tlabels.append(input_table.getValueAsDouble(i, \"label\"))\n\tmeans.append(input_table.getValueAsDouble(i, \"mean\"))\n\ts_values.append(input_table.getValueAsDouble(i, \"s_value\"))\n\t\nbest_t = triangle_threshold_index(means)\nbest_mean = means[best_t]\nbest_s_value = s_values[best_t]\nbest_label = labels[best_t]\n\n#progress_info.log(str(s_values))\n#progress_info.log(str(means))\nprogress_info.log(\"Threshold is i=\" + str(best_t) + \", mean=\" + str(best_mean) + \", strip=\" + str(best_s_value))\n\ndata_batch.addOutputData(output_slot, input_table, [JIPipeTextAnnotation(\"t_mean\", str(best_mean)), JIPipeTextAnnotation(\"t_s_value\", str(best_s_value)), JIPipeTextAnnotation(\"t_label\", str(best_label))], JIPipeTextAnnotationMergeMode.OverwriteExisting, progress_info)\n\n",
          "collapsed" : false,
          "external-script-file" : {
            "content" : "",
            "enabled" : false
          }
        },
        "jipipe:node:bookmarked" : false,
        "jipipe:algorithm:pass-through" : false,
        "jipipe:node:name" : "Find threshold (Triangle)",
        "jipipe:algorithm:runtime-partition" : {
          "index" : 0
        },
