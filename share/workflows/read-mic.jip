        "jipipe:node-info-id" : "python-script-iterating",
        "jipipe:algorithm:enabled" : true,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from org.hkijena.jipipe.plugins.tables.datatypes import ResultsTableData\nfrom org.hkijena.jipipe.plugins.imagejdatatypes.datatypes import ImagePlusData\nimport math\n\ninput_slot_labels = input_slot_map[\"Labels\"]\ninput_slot_raw = input_slot_map[\"Raw\"]\ninput_slot_value = input_slot_map[\"Value\"]\noutput_slot_table = output_slot_map[\"Output\"]\n\nip_labels = data_batch.getInputData(input_slot_labels, ImagePlusData, progress_info).getImage().getProcessor()\nip_raw = data_batch.getInputData(input_slot_raw, ImagePlusData, progress_info).getImage().getProcessor()\nip_value = data_batch.getInputData(input_slot_value, ImagePlusData, progress_info).getImage().getProcessor()\n\nassert ip_labels.getWidth() == ip_raw.getWidth() \nassert ip_labels.getHeight() == ip_raw.getHeight()\nassert ip_labels.getWidth() == ip_value.getWidth() \nassert ip_labels.getHeight() == ip_value.getHeight()\n\nn_labels = int(ip_labels.getStats().max)\nlabels_sum = [0.0] * n_labels\nlabels_num = [0] * n_labels\nlabels_min = [float(\"inf\")] * n_labels\nlabels_max = [float(\"-inf\")] * n_labels\nlabels_v = [float(\"inf\")] * n_labels\n\nprogress_info.log(\"n_labels: \" + str(n_labels))\n\nn_pixels = ip_labels.getWidth() * ip_labels.getHeight()\n\nfor i in range(n_pixels):\n\tl = int(ip_labels.getf(i))\n\tif l > 0:\n\t\tv1 = ip_raw.getf(i)\n\t\tv2 = ip_value.getf(i)\n\t\tlabels_sum[l - 1] += v1\n\t\tlabels_num[l - 1] += 1\n\t\tlabels_min[l - 1] = min(labels_min[l - 1], v1)\n\t\tlabels_max[l - 1] = max(labels_max[l - 1], v1)\n\t\tlabels_v[l - 1] = v2\n\nresult = ResultsTableData()\n\nfor i in range(n_labels):\n\tresult.addAndModifyRow().set(\"label\", i + 1).set(\"mean\", labels_sum[i] / labels_num[i]).set(\"min\", labels_min[i]).set(\"max\", labels_max[i]).set(\"s_value\", labels_v[i]).set(\"log_s_value\", math.log(labels_v[i]))\n\t\ndata_batch.addOutputData(output_slot_table, result, progress_info)\n\n",
          "collapsed" : false,
          "external-script-file" : {
            "content" : "",
            "enabled" : false
          }
        },
        "jipipe:node:bookmarked" : false,
