        "jipipe:node-info-id" : "python-script-iterating-simple",
        "jipipe:algorithm:enabled" : false,
        "jipipe:node:ui-locked" : false,
        "code" : {
          "code" : "from org.hkijena.jipipe.api.data import JIPipeData\nfrom org.hkijena.jipipe.api.annotation import JIPipeTextAnnotation, JIPipeTextAnnotationMergeMode\n\ndef otsu_threshold_index(hist):\n    \"\"\"\n    Otsu threshold for an already-computed histogram.\n\n    Args:\n        hist: sequence (e.g., float[] or list) where hist[i] is the bin count/weight.\n\n    Returns:\n        int: threshold index t in [0, len(hist)-1]\n    \"\"\"\n    n = len(hist)\n    if n == 0:\n        raise ValueError(\"Histogram is empty\")\n\n    # Total weight (sum of histogram)\n    total = 0.0\n    for v in hist:\n        total += float(v)\n\n    if total <= 0.0:\n        # Degenerate histogram: no mass; choose 0 by convention\n        return 0\n\n    # Sum of i * hist[i]\n    sum_total = 0.0\n    for i in range(n):\n        sum_total += i * float(hist[i])\n\n    sum_b = 0.0     # cumulative sum of i*hist[i] for background\n    w_b = 0.0       # cumulative weight for background\n    max_sigma = -1.0\n    best_t = 0\n\n    for t in range(n):\n        w_b += float(hist[t])\n        if w_b <= 0.0:\n            continue\n\n        w_f = total - w_b\n        if w_f <= 0.0:\n            break  # remaining bins are all background; foreground empty\n\n        sum_b += t * float(hist[t])\n\n        m_b = sum_b / w_b\n        m_f = (sum_total - sum_b) / w_f\n\n        # Between-class variance: w_b * w_f * (m_b - m_f)^2\n        diff = m_b - m_f\n        sigma = w_b * w_f * diff * diff\n\n        if sigma > max_sigma:\n            max_sigma = sigma\n            best_t = t\n\n    return best_t\n\ninput_slot = input_slot_map[\"Input\"]\noutput_slot = output_slot_map[\"Output\"]\ninput_table = data_batch.getInputData(input_slot, JIPipeData, progress_info)\nmeans = []\ns_values = []\n\nfor i in range(input_table.getRowCount()):\n\tmeans.append(input_table.getValueAsDouble(i, \"mean\"))\n\ts_values.append(input_table.getValueAsDouble(i, \"s_value\"))\n\t\nbest_t = otsu_threshold_index(means)\nbest_mean = means[best_t]\nbest_s_value = s_values[best_t]\n\n#progress_info.log(str(s_values))\n#progress_info.log(str(means))\nprogress_info.log(\"Threshold is i=\" + str(best_t) + \", mean=\" + str(best_mean) + \", strip=\" + str(best_s_value))\n\ndata_batch.addOutputData(output_slot, input_table, [JIPipeTextAnnotation(\"t_mean\", str(best_mean)), JIPipeTextAnnotation(\"t_s_value\", str(best_s_value))], JIPipeTextAnnotationMergeMode.OverwriteExisting, progress_info)\n\n",
          "collapsed" : false,
          "external-script-file" : {
            "content" : "",
            "enabled" : false
          }
        },
        "jipipe:node:bookmarked" : false,
