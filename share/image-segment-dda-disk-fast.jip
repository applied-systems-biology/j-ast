              "jipipe:node-info-id" : "ij1-roi-filter-statistics",
              "output-empty-lists" : true,
              "jipipe:algorithm:enabled" : true,
              "jipipe:node:ui-locked" : false,
              "jipipe:node:bookmarked" : false,
              "jipipe:algorithm:pass-through" : false,
              "measure-in-physical-units" : true,
              "jipipe:node:name" : "Filter ROI by statistics",
              "jipipe:algorithm:runtime-partition" : {
                "index" : 0
              },
              "jipipe:node:description" : "<html><head></head><body></body></html>",
              "filter" : {
                "expression" : "SET_VARIABLE(\"cminf_px\", custom.minFeret / NUM(PixelSize));\nSET_VARIABLE(\"cmaxf_px\", custom.maxFeret / NUM(PixelSize));\nMinFeret >= cminf_px AND Feret >= cminf_px AND MinFeret <= cmaxf_px AND Feret <= cmaxf_px AND Circ. >= custom.minCirc"
              },
              "measurements" : {
                "values" : [ "FeretDiameter", "ShapeDescriptors" ],
                "collapsed" : false
              },
              "jipipe:algorithm:custom-expression-variables" : {
                "parameters" : {
                  "minFeret" : {
                    "key" : "minFeret",
                    "name" : "Minimum diameter (mm)",
                    "description" : "",
                    "hidden" : false,
                    "field-class" : "java.lang.Double",
                    "value" : 2.0,
                    "short-key" : "minFeret",
                    "ui-order" : 0,
                    "field-class-id" : "double"
                  },
                  "maxFeret" : {
                    "key" : "maxFeret",
                    "name" : "Maximum diameter (mm)",
                    "description" : "",
                    "hidden" : false,
                    "field-class" : "java.lang.Double",
                    "value" : 12.0,
                    "short-key" : "maxFeret",
                    "ui-order" : 0,
                    "field-class-id" : "double"
                  },
                  "minCirc" : {
                    "key" : "minCirc",
                    "name" : "Minimum circularity",
                    "description" : "",
                    "hidden" : false,
                    "field-class" : "java.lang.Double",
                    "value" : 0.5,
                    "short-key" : "minCirc",
                    "ui-order" : 0,
                    "field-class-id" : "double"
                  }
                }
              },
              "jipipe:adaptive-parameters/attach-parameter-annotations" : true,
