              "value" : "",
              "short-key" : "path",
              "ui-order" : -90,
              "field-class-id" : "path"
            },
            "must-exist" : {
              "key" : "must-exist",
              "name" : "Check if exists",
              "description" : "Indicates that the directory should exist",
              "hidden" : false,
              "field-class" : "boolean",
              "value" : true,
              "short-key" : "must-exist",
              "ui-order" : 0,
              "field-class-id" : "primitive.boolean"
            },
            "key" : {
              "key" : "key",
              "name" : "Key",
              "description" : "The key that will be used to access the directory. Cannot be empty.",
              "hidden" : false,
              "field-class" : "java.lang.String",
              "value" : "",
              "short-key" : "key",
              "ui-order" : -100,
